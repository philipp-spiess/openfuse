FROM node:22-bookworm-slim

# Install libfuse2 + build tooling for fuse-native
RUN apt-get update && apt-get install -y libfuse-dev fuse pkg-config python3 make g++ && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN npm install -g bun

# Pre-install fuse-native with npm (compiles from source with node-gyp)
RUN mkdir /fuse-deps && cd /fuse-deps && npm init -y && npm install fuse-native

WORKDIR /app
COPY . .

# Install deps with bun, build packages
RUN bun install --trust && bun run build

# Symlink fuse-native + transitive deps
RUN mkdir -p packages/@openfuse/fuse/node_modules && \
    for pkg in $(ls /fuse-deps/node_modules/); do \
      [ -d "/fuse-deps/node_modules/$pkg" ] && \
      ln -sf "/fuse-deps/node_modules/$pkg" "packages/@openfuse/fuse/node_modules/$pkg"; \
    done

# Also compile the C bridge for bun:ffi testing
RUN cd packages/@openfuse/fuse && \
    cc -shared -o src/bridge/fuse_bridge.so src/bridge/fuse_bridge.c \
    $(pkg-config --cflags --libs fuse) -fPIC -pthread

CMD ["node", "tests/node-mount-test.ts"]
