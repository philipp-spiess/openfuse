{
  "name": "openfuse",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "optionalDependencies": {
    "@openfuse/fuse": "^0.0.1",
    "@openfuse/fskit": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "rm -rf ./dist && bun build ./src/index.ts --outdir ./dist --target node --external @openfuse/fuse --external @openfuse/fskit && tsc -p ./tsconfig.json",
    "prepack": "bun run build",
    "test": "bun test"
  }
}
